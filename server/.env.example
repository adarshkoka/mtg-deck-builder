# Copy to .env and fill in. Never commit .env.

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Model used by every AI call. Change it here only.
GEMINI_MODEL=gemini-3.8-flash
# Embedding model for semantic card search.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Minimum seconds between Gemini calls (keeps the free tier from returning 429s).
GEMINI_MIN_INTERVAL_S=4

# --- API security ---
# Clients must send this in the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- Deck-building agent ---
# manual = hand-written agent loop | pydantic_ai = same agent on Pydantic AI | langgraph = fixed workflow
AGENT_ENGINE=manual
# Provider for the pydantic_ai engine: gemini | anthropic
AGENT_PROVIDER=gemini
# Most model turns one build may use (each turn is one Gemini request)
AGENT_MAX_TURNS=8
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Infrastructure (docker compose sets these for the containers) ---
DATABASE_URL=postgresql+asyncpg://mtg:mtg@localhost:5432/mtg
REDIS_URL=redis://localhost:6379/0
# celery = background jobs on the worker | inline = in the API process (no Redis needed)
TASK_RUNNER=celery

# --- Tracing (none | console | otlp) ---
OTEL_EXPORTER=none
